# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# If unset, the API runs UNAUTHENTICATED — anyone who can reach this port can control the
# service. Set this to a long random value (e.g. `openssl rand -hex 32`) and send it as
# `Authorization: Bearer <key>` or `X-Api-Key: <key>` on every request except /api/health.
API_KEY=

# --- Database ---
DATABASE_PATH=./data/vrms.db

# --- Storage paths ---
DOWNLOAD_TEMP_DIR=./data/downloads
LIBRARY_MOVIES_DIR=./data/library/movies
LIBRARY_SHOWS_DIR=./data/library/shows
LIBRARY_ANIME_DIR=./data/library/anime
LIBRARY_MUSIC_DIR=./data/library/music

# --- Queue ---
QUEUE_CONCURRENCY=2
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF_MS=30000

# --- Download provider: qBittorrent ---
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=changeme

# --- Download provider: SABnzbd (usenet) ---
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# --- Newznab-compatible indexer (search for the SABnzbd provider — SABnzbd itself can't search) ---
NEWZNAB_URL=
NEWZNAB_API_KEY=

# --- Metadata: TMDB (movies + TV) ---
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# AniList and MusicBrainz require no API key.

# --- Jellyfin ---
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# --- Notifications ---
DISCORD_WEBHOOK_URL=

# --- Virus scanning (optional) ---
VIRUS_SCAN_ENABLED=false
CLAMD_HOST=localhost
CLAMD_PORT=3310
