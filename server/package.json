{
  "name": "vrms-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VeryRare Media Service backend — media acquisition, processing, and library automation pipeline.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
